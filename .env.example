# THE FORUM — environment variables.
# Copy to .env.local (gitignored) and fill in. Never commit real values, never paste them into chats/issues.

# ── Data ───────────────────────────────────────────────────────────────
# "mock" (default) renders the frontend's sample fixtures; "mongo" reads from MongoDB Atlas.
DATA_SOURCE=mock

# Atlas → Database → Connect → Drivers. Create a dedicated DB user with readWrite on MONGODB_DB only,
# and restrict Network Access to your server's IPs (0.0.0.0/0 only for quick local testing).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=the_forum
# Optional: connection pool size per server instance (default 10).
# MONGODB_MAX_POOL=10

# ── Security ───────────────────────────────────────────────────────────
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Used to key rate-limit buckets. (Sessions are random server-side tokens, so rotating this does NOT log anyone out.)
SESSION_SECRET=

# Session cookies are Secure by default (browsers accept that on http://localhost too).
# Set to "false" only if you test over plain http on a non-localhost host.
# COOKIE_SECURE=true

# Extra origins allowed to POST/PATCH/DELETE (comma-separated), e.g. a separate admin domain.
# Same-origin requests are always allowed.
# ALLOWED_ORIGINS=https://admin.theforum.pk

# ── Uploads ────────────────────────────────────────────────────────────
# Cloudinary (use this on Vercel): paste the "API environment variable" from
# Cloudinary → Settings → API Keys. Setting it is enough — it is picked automatically.
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Folder inside your Cloudinary media library (default "the-forum").
# CLOUDINARY_FOLDER=the-forum
# "local" (default) writes to UPLOAD_DIR and serves via /api/uploads/… (dev / single server only).
# "cloudinary" forces Cloudinary. If CLOUDINARY_URL is set, "local"/unset also switches to Cloudinary.
UPLOAD_DRIVER=local
UPLOAD_DIR=.uploads
UPLOAD_MAX_BYTES=5242880
# UPLOAD_PUBLIC_BASE=/api/uploads

# ── Scripts (npm run db:seed / db:create-admin) ─────────────────────────
# Password given to every demo account by the seed script (≥ 10 chars). If unset, one is generated and printed once.
# SEED_DEMO_PASSWORD=
# Password for db:create-admin (≥ 12 chars). If unset, you are prompted (hidden input).
# ADMIN_PASSWORD=

# ── Site URL ───────────────────────────────────────────────────────────
# Public base URL; used for the Google redirect URI. Local dev: http://localhost:3000
APP_URL=http://localhost:3000

# ── Email (verification + password-reset codes) ─────────────────────────
# Gmail: SMTP_USER = the Gmail address; SMTP_PASS = a 16-character App Password
# (Google Account → Security → 2-Step Verification → App passwords). Spaces are ignored.
# If unset in development, codes are printed to the server console instead (clearly marked).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="THE FORUM <you@gmail.com>"

# ── Google sign-in ─────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: <APP_URL>/api/auth/google/callback  (e.g. http://localhost:3000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
